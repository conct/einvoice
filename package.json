{
  "name": "@erechnung/core",
  "version": "2.0.0",
  "description": "Deutsche E-Rechnung: EN 16931 Datenmodell, CII/UBL XML, PDF/A-3 (ZUGFeRD 2.3 / Factur-X, XRechnung) - isomorph fuer Node, Browser und React Native",
  "license": "Apache-2.0",
  "author": "Daniel von Lühmann <mail@feif.space>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conct/einvoice.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures/sample.d.ts",
      "default": "./dist/fixtures/sample.js"
    },
    "./assets": {
      "types": "./dist/assets/index.d.ts",
      "default": "./dist/assets/index.js"
    },
    "./assets/node": {
      "types": "./dist/assets/node.d.ts",
      "default": "./dist/assets/node.js"
    },
    "./files/*": "./files/*"
  },
  "keywords": [
    "e-rechnung",
    "zugferd",
    "factur-x",
    "xrechnung",
    "en16931",
    "pdfa3",
    "cii",
    "ubl",
    "datev",
    "invoice"
  ],
  "homepage": "https://github.com/conct/einvoice#readme",
  "bugs": "https://github.com/conct/einvoice/issues",
  "files": [
    "dist",
    "files",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LIZENZEN.md"
  ],
  "scripts": {
    "build": "tsup",
    "release": "npm run typecheck && npm test && npm run build && npm run probe",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.kern.json",
    "test": "vitest run",
    "probe": "node tools/probe.mjs",
    "schrift": "node tools/schrift-erzeugen.mjs",
    "icc": "node tools/icc-erzeugen.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "fast-xml-parser": "^5.11.0",
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
